# Copie este arquivo para ".env" (sem o .example) e cole suas chaves gratuitas de IA.
# Você pode configurar uma ou várias - quanto mais tiver, mais a ferramenta consegue
# alternar entre elas quando uma bater a cota gratuita do dia.

# Google Gemini - pegue a sua em: https://aistudio.google.com/apikey
GEMINI_API_KEY=cole_sua_chave_aqui

# Groq - pegue a sua em: https://console.groq.com/keys
GROQ_API_KEY=cole_sua_chave_aqui

# NVIDIA Build (NIM) - pegue a sua em: https://build.nvidia.com
NVIDIA_API_KEY=cole_sua_chave_aqui

# Opcional: coloque "true" só se estiver desenvolvendo/depurando a ferramenta.
# Deixe "false" (ou apague a linha) no uso normal do dia a dia.
PROSPECCAO_DEBUG=false

# Opcional: limite global do corpo HTTP em bytes (padrão 16 MiB; máximo 64 MiB).
# PROSPECCAO_MAX_CONTENT_LENGTH=16777216

# Exceção SOMENTE para diagnóstico manual de certificado inválido. Mantém
# false/ausente no uso normal; nunca habilite isso para tráfego com credenciais.
# PROSPECCAO_ALLOW_INSECURE_SITE_CHECK=false

# Opcional: nível de detalhe do logs/prospeccao.log (DEBUG, INFO, WARNING, ERROR).
# PROSPECCAO_LOG_LEVEL=INFO

# Opcional: caminho do node.exe usado pelo scraper do Google Maps. Só precisa
# definir se o seu Node NÃO estiver no local padrão (C:\Program Files\nodejs).
# PLAYWRIGHT_NODEJS_PATH=C:\caminho\para\node.exe

# Opcional: vault Obsidian usado pela exportação explícita e somente leitura
# ProspectOS -> Obsidian. A CLI também aceita --vault.
# PROSPECTOS_OBSIDIAN_VAULT=C:\caminho\para\SOL-VAULT
